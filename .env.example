# Apple ID + an app-specific password from appleid.apple.com
ICLOUD_USERNAME=you@icloud.com
ICLOUD_PASSWORD=abcd-efgh-ijkl-mnop

# Or, instead of the above, a published calendar URL:
# ICS_URL=https://p01-calendars.icloud.com/published/.../calendar.ics

# The NWS asks API users to identify themselves.
USER_AGENT=pi-wall-dashboard (you@example.com)
